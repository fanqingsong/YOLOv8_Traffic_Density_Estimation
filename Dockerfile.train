FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=1000

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libglib2.0-0 libgl1 libgomp1 unzip \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-train.txt .
RUN pip install --upgrade pip \
    && pip install --retries 10 --timeout 1000 \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        -r requirements-train.txt

COPY scripts/ ./scripts/
