# Kaggle API (create at https://www.kaggle.com/settings -> API -> Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional: directory containing kaggle.json (default ./.kaggle)
# KAGGLE_CONFIG_DIR=./.kaggle

# Training overrides (optional)
# TRAIN_EPOCHS=100
# TRAIN_BATCH=32
# TRAIN_DEVICE=0
# BASE_MODEL=yolov8n.pt
# TRAIN_PATIENCE=50
# TRAIN_LR0=0.0001
# TRAIN_LRF=0.1
# TRAIN_DROPOUT=0.1
# TRAIN_SEED=0
# EXPORT_ONNX=true

# Dataset preparation override (container default shown)
# SAMPLE_VIDEO_OUTPUT=/data/sample_video.mp4
